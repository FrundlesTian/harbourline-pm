%% Harbourline AI PM system - architecture (source: app/pipeline.py, app/audit.py, app/pmtool.py, app/change.py)
%% Thick arrows (==>) = automatic machine hand-offs, logged in the `handoffs` table (audit.handoff).
%% Hexagons = named human checkpoints HC1-HC7 (audit.CHECKPOINTS). Dotted arrows = optional LLM calls.
flowchart LR
    subgraph SRC["Sources (read-only)"]
        PACK["Data pack 00-07<br/>brief + sponsor answers"]
        CE["Change events<br/>CE-01 / CE-02 (JSON)"]
    end

    subgraph STORE["Fact store and ledger (SQLite, app/db.py)"]
        IDX["sources: chunks with line ranges<br/>+ BM25 index"]
        FACTS["facts F01-F78<br/>(quote verified in source)"]
        LEDGER["audit_log · approvals · handoffs<br/>runs · kv (origin, LLM cache)"]
    end

    LLM["LLM client app/llm.py<br/>Gemini (primary) then DeepSeek (backup)<br/>temperature 0, cached"]

    subgraph AGENTS["Agents"]
        PLAN["1 Planning Agent<br/>scope, Sponsor Questions, conflicts,<br/>WBS L3 + dictionary, milestones"]
        RISK["4 Risk & What-if Agent<br/>register, seed QA, W1-W3"]
        GOV["Governance layer<br/>bias & fairness check B1-B6"]
        REP["5 Reporting Agent<br/>EDC update + NRF report"]
        CRIT["5 Critic Agent<br/>C1, C3-C8: PASS / STOP"]
        TOOL["2 Tool Integration Agent<br/>preview, apply, read-back"]
        MEM["3 Memory & Retrieval Agent<br/>cited answers / NOT FOUND"]
        CHG["6 Change Agent<br/>stale list, impact note, actions"]
    end

    HC1{{"HC1 scope + Sponsor Questions"}}
    HC2{{"HC2 plan baseline (plan_hash)"}}
    HC3{{"HC3 PM write (preview_id)"}}
    HC4{{"HC4 risk register (risk_hash)"}}
    HC5{{"HC5 report release"}}
    HC6{{"HC6 change actions"}}
    HC7{{"HC7 bias sign-off"}}

    PM[("PM tool<br/>Jira Cloud REST v3<br/>or mock board (same contract)")]
    READERS["EDC and NRF readers"]

    PACK --> IDX --> FACTS
    CE --> CHG
    IDX --> PLAN
    FACTS --> PLAN
    IDX --> MEM

    PLAN ==>|"hand-off: WBS + milestones"| RISK
    RISK ==>|"hand-off: register + what-ifs"| REP
    GOV --> REP
    REP ==>|"hand-off: draft + claims"| CRIT
    CRIT -.->|"STOP findings: up to 3 revisions"| REP
    CHG ==>|"hand-off: stale reports refreshed"| REP

    PLAN -.-> LLM
    RISK -.-> LLM
    REP -.-> LLM
    CHG -.-> LLM
    MEM -.-> LLM

    PLAN --> HC1
    PLAN --> HC2 --> TOOL
    TOOL --> HC3 --> PM
    PM -->|"read-back"| TOOL
    RISK --> HC4
    CRIT -->|"PASS only"| HC5 --> READERS
    CHG --> HC6
    HC6 -->|"re-score, milestone note,<br/>assumption update, PM comment + label"| PM
    GOV --> HC7

    AGENTS -. "every write" .-> LEDGER

    classDef hc fill:#fff4d6,stroke:#b07d00,color:#3d2c00
    classDef auto stroke-width:3px
    class HC1,HC2,HC3,HC4,HC5,HC6,HC7 hc
