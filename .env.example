# Copy to .env (git-ignored). Tokens are personal: never commit, screenshot or paste them.

# --- LLM (optional; the system runs deterministically without it) ---
# Primary: Gemini via Google AI Studio (free tier). Backup: DeepSeek. Calls that fail on
# the first provider are retried on the next (order: HCH_LLM_ORDER=gemini,deepseek).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_REASONING_EFFORT=none     # empty for models that reject the parameter
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# USD per 1M tokens - check DeepSeek's current price page
# DEEPSEEK_PRICE_IN_PER_M=0.28
# DEEPSEEK_PRICE_OUT_PER_M=0.42
# HCH_DISABLE_LLM=1

# --- PM tool (optional; without these the local mock board is used) ---
# JIRA_BASE_URL=https://<your-site>.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=HCH
# Issue types are matched by hierarchy level (Epic / standard / subtask), so localized sites
# (e.g. 长篇故事 / 任务 / 子任务) work without settings. Override only if the guess is wrong:
# JIRA_TYPE_EPIC=长篇故事
# JIRA_TYPE_TASK=任务
# JIRA_TYPE_SUBTASK=子任务
# PM_BACKEND=mock                  # force the mock board even when Jira is configured
# Read-only connection check:  python3 scripts/jira_check.py

# HCH_PORT=8000

# Generation mode. "llm" (default): with an LLM key set, the plan, risk register,
# reports and change analysis are generated by the LLM and validated; the curated baseline
# is the fallback. "baseline": always use the curated baseline (reproducible regression).
# HCH_GENERATION=llm
# HCH_LLM_FRESH=1   # ignore cached LLM responses and call the model again
